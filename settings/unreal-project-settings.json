{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash \"<workspace>/.claude/hooks/verify-build.sh\"", "timeout": 600 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"<workspace>/.claude/hooks/verify-build.sh\"", "timeout": 600 }
        ]
      }
    ]
  }
}

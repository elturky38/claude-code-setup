{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"~/.claude/hooks/enforce-method.js\"", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"~/.claude/hooks/enforce-method.js\"", "timeout": 10 },
          { "type": "command", "command": "node \"~/.claude/hooks/architecture-gate.js\"", "timeout": 20, "statusMessage": "Checking ownership and boundaries" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"~/.claude/hooks/verify-before-done.js\"", "timeout": 15, "statusMessage": "Checking the completion claim" }
        ]
      }
    ]
  }
}
